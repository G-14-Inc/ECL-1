  "decisions": [
    {
      "compatibility_effect": "Previously accepted admitting pairs evaluated at or after request expiry are now refused. No new authorization-end bound is imposed by request expiry.",
      "contract": "An admit requires evaluated_at < request.expires_at, without expiry skew. deny, hold and challenge may be evaluated at or after expiry. Resulting authorization may outlive the request within DCMP2-049 bounds.",
      "diagnostic": "ecl.error.request-binding-invalid.v1",
      "id": "DESIGN-05",
      "order": "After request identity/digest and issued-at chronology, before admit audience, scope and authority checks.",
      "requirements": [
        "DCMP2-047",
        "DCMP2-049"
      ]
    },
    {
      "compatibility_effect": "A complete history containing one admitted continuation and denied or challenged reuse can verify. A missing approval alone leaves it incomplete. Two admits remain invalid, including when the named approval is missing.",
      "contract": "Only two admitted continuations of the same challenge response violate continuation uniqueness. Refusal histories retain all other binding, approval, expiry and causal checks.",
      "diagnostic": "ecl.error.decision-binding-invalid.v1",
      "id": "DESIGN-08",
      "requirements": [
        "DCMP2-057",
        "EBMP2-078"
      ]
    }
  ],
