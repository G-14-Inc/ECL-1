  RequestSignature( verify(rsig,
                           pae('dcmp', <'decision_request', rid, issuer, aud, <t, p>, use>), pkI)
  ),
  DP_Seen( $D, rid ),
  DP_Issue( $D, issuer, aud, rid,
            h(<'decision_request', rid, issuer, aud, <t, p>, use>), ~aid, t, p, ~win
  )
  ]->
   [
   !Window( ~aid, ~win ),
   Out( <
         <'decision_response', ~mid, rid, 
          h(<'decision_request', rid, issuer, aud, <t, p>, use>), 'admit', 
          <'authorization', ~aid, aud, h(<rid, t, p>), use, ~win>, $D>, 
         sign(pae('dcmp',
                  <'decision_response', ~mid, rid, 
                   h(<'decision_request', rid, issuer, aud, <t, p>, use>), 'admit', 
                   <'authorization', ~aid, aud, h(<rid, t, p>), use, ~win>, $D>),
