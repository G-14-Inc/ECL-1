lemma executable:
  exists-trace
  "∃ E D t p a rid w #i #j.
    ((EP_Sent( E, rid,
               h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), t, p
      ) @ #j) ∧
     (Execute( E, t, p, a, rid, w, D ) @ #i)) ∧
    (¬(∃ X R #r. Reveal( X, R ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ E D t p a rid w #i #j.
  (EP_Sent( E, rid,
            h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), t, p
   ) @ #j) ∧
  (Execute( E, t, p, a, rid, w, D ) @ #i)
 ∧
  ∀ X R #r. (Reveal( X, R ) @ #r) ⇒ ⊥"
*/
by sorry

lemma request_origin:
  all-traces
  "∀ D I aud rid hreq a t p w #i.
    (DP_Issue( D, I, aud, rid, hreq, a, t, p, w ) @ #i) ⇒
    ((∃ #k. (EP_Sent( I, rid, hreq, t, p ) @ #k) ∧ (#k < #i)) ∨
     (∃ #r. (Reveal( I, 'request' ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ D I aud rid hreq a t p w #i.
  (DP_Issue( D, I, aud, rid, hreq, a, t, p, w ) @ #i)
 ∧
  (∀ #k. (EP_Sent( I, rid, hreq, t, p ) @ #k) ⇒ ¬(#k < #i)) ∧
  (∀ #r. (Reveal( I, 'request' ) @ #r) ⇒ ¬(#r < #i))"
*/
simplify
solve( !Pk( I, 'request', pkI ) ▶₁ #i )
  case Register
  solve( !Ltk( $D, 'response', skD ) ▶₂ #i )
    case Register
    solve( splitEqs(0) )
      case split_case_1
      SOLVED // trace found
    qed
  qed
qed

