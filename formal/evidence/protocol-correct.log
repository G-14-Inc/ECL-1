lemma authorization_scope_and_audience:
  all-traces
  "∀ E t p a rid w D #i.
    (Execute( E, t, p, a, rid, w, D ) @ #i) ⇒
    ((∃ I hreq #j.
       (DP_Issue( D, I, E, rid, hreq, a, t, p, w ) @ #j) ∧ (#j < #i)) ∨
     (∃ #r. (Reveal( D, 'response' ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ E t p a rid w D #i.
  (Execute( E, t, p, a, rid, w, D ) @ #i)
 ∧
  (∀ I hreq #j.
    (DP_Issue( D, I, E, rid, hreq, a, t, p, w ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (Reveal( D, 'response' ) @ #r) ⇒ ¬(#r < #i))"
*/
simplify
solve( Execute( E, t, p, a, rid, w, D ) @ #i )
  case EP_Execute
  solve( EP_Accepted( E, D, rid, t, p, a, E, h(<rid, t, p>), 'single_use',
                      w
         ) ▶₀ #i )
    case EP_Receive
    solve( !KU( sign(pae('dcmp',
                         <'decision_response', mid, ~rid, 
                          h(<'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>), 'admit', 
                          <'authorization', a, $E, h(<~rid, t, p>), 'single_use', w>, $X>),
                     ~sk)
           ) @ #vk.24 )
      case DP_Decide
      by contradiction /* from formulas */
    next
      case c_sign
      solve( !KU( ~sk ) @ #vk.29 )
        case Reveal
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case EP_Present
  solve( !Pk( D, 'response', pk(x) ) ▶₁ #i )
    case Register
