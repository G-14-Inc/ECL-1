theory DCMP2_Binding
begin

/*
 * Binding and authentication properties of DCMP-2 decision requests and
 * responses inside the ECL integrity envelope (INTEGRITY-ENVELOPE-1).
 *
 * Parties. An enforcement point (EP) signs a decision request for an action,
 * names itself as the requested audience and sends it to a decision point
 * (DP). An EP can also adopt an authenticated request signed by an agent.
 * Adoption retains the complete modeled request without authorizing an
 * effect. The DP verifies the request signature under a key the trust policy
 * registers for the request role and permits one decision per DP identity
 * and request identifier (stronger than DCMP2-005). It answers an admit with
 * a signed decision response that
 * names the request by identifier and digest (DCMP2-045, DCMP2-046) and
 * carries an authorization bound to the audience (DCMP2-048), the scope
 * digest of the request identifier and action (DCMP2-044), the single-use
 * policy (DCMP2-050) and a validity window (DCMP2-049). The EP verifies the
 * response under a key registered for the response role (TP1-004, TP1-005),
 * checks the binding, and executes only within the authorization. Direct
 * presentation checks the signed response against a retained request context,
 * including its digest; a matching action scope alone is insufficient.
 *
 * The governed AI system (the actor below). The network is the Dolev-Yao
 * adversary, so the actor proposes any action, reads, replays, reorders and
 * redirects every message, and presents any authorization it has seen together
 * with any action at any EP (rule EP_Present). Every key can be revealed (rule
 * Reveal); the actor's own request-signing key (agent-signed requests, which
 * ECL1N-0156 permits) is a key the adversary has revealed.
 *
 * Abstractions. Signatures are perfect (builtin signing), digests are
 * perfect hashes, and the DSSE pre-authentication encoding is a free
 * constructor pae(payload type, payload), so the payload type is part of
 * every signing input (IE1-009, IE1-010). The decision point's policy is
 * abstracted to admit: deny, hold and challenge carry no authorization
 * (DCMP2-012) and cannot be executed; their semantics are checked in the
 * TLA+ model. The EP's clock is an assumption (restriction
 * EnforcementClock); the model shows that the window the EP checks is the
 * one the DP signed. The trust policy is trusted: it holds at most one key
 * per principal and role, and an attacker cannot add one (TP1-001).
 *
 * Eight flaw variants remove a named restriction. shared_role_key instead
 * adds Register_shared, permitting one key to serve both request and
 * response roles. Select a flaw with -D=<flag>:
 *   skip_response_signature    the EP accepts a response without its signature
 *   shared_role_key            one key serves the request and response roles
 *   response_not_bound         the EP does not check request_id and digest
 *   presentation_not_bound     direct presentation omits request binding
 *   no_scope_check             the EP does not check the scope digest
 *   no_audience_check          the EP does not check the audience
 *   no_single_use              the EP does not keep consumed authorizations
 *   dp_no_message_identity     the DP does not refuse a reused identifier
 *   dp_skips_request_signature the DP does not verify the request signature
 */

builtins: signing, hashing

functions: pae/2

/* ------------------------------------------------------------------ */
/* Checks                                                              */

#ifdef dp_skips_request_signature
#else
/* The DP verifies the request signature under the issuer's request key. */
restriction RequestSignatureVerified:
  "All x #i. RequestSignature(x) @ #i ==> x = true"
#endif

#ifdef dp_no_message_identity
#else
/* One decision per DP identity and request identifier. This restriction
   also excludes identical replay, which DCMP2-005 alone does not forbid. */
restriction UniqueRequestIdentifier:
  "All d rid #i #j. DP_Seen(d, rid) @ #i & DP_Seen(d, rid) @ #j ==> #i = #j"
#endif

#ifdef skip_response_signature
#else
/* The EP verifies the response under the named decision point's response
   key (TP1-004, TP1-005). */
restriction ResponseSignatureVerified:
  "All x #i. ResponseSignature(x) @ #i ==> x = true"
#endif

#ifdef response_not_bound
#else
/* DCMP2-045, DCMP2-046: the response names the request by identifier and by
   the digest of the request. */
restriction ResponseAnswersTheRequest:
  "All r1 r2 d1 d2 #i. ResponseAnswers(r1, r2, d1, d2) @ #i ==> r1 = r2 & d1 = d2"
#endif

#ifdef presentation_not_bound
#else
/* Direct presentation must bind the same retained authenticated context. */
restriction PresentationAnswersTheRequest:
  "All r1 r2 d1 d2 #i. PresentationAnswers(r1, r2, d1, d2) @ #i ==> r1 = r2 & d1 = d2"
#endif

#ifdef no_audience_check
#else
/* DCMP2-048: the authorization's audience is the executing EP. */
restriction AudienceIsTheEnforcementPoint:
  "All a e #i. AudienceCheck(a, e) @ #i ==> a = e"
#endif

#ifdef no_scope_check
#else
/* DCMP2-044: the scope digest covers the request identifier and the action
   that is executed. */
restriction ScopeCoversTheAction:
  "All s1 s2 #i. ScopeCheck(s1, s2) @ #i ==> s1 = s2"
#endif

#ifdef no_single_use
#else
/* DCMP2-050, EBMP2-008: an EP keeps the authorizations it consumed and
   refuses a second use. */
restriction SingleUse:
  "All e a #i #j. Consume(e, a) @ #i & Consume(e, a) @ #j ==> #i = #j"
#endif

/* The use policy is single use. */
restriction UsePolicy:
  "All u #i. UseCheck(u) @ #i ==> u = 'single_use'"

/* The EP's clock: an authorization is used only before its window has passed
   (DCMP2-049, EBMP2-050). */
restriction EnforcementClock:
  "All a w #i #j. InWindow(a, w) @ #i & Expired(a, w) @ #j ==> #i < #j"

/* The trust policy holds at most one key per principal and role. */
restriction OneRegistration:
  "All x r k1 k2 #i #j. Registered(x, r, k1) @ #i & Registered(x, r, k2) @ #j ==> #i = #j"

/* A retained request context is authenticated under its request-role key.
   Context adoption never grants authority to execute. */
restriction RequestContextSignatureVerified:
  "All x #i. RequestContextSignature(x) @ #i ==> x = true"

/* A logical EP cannot retain conflicting immutable request content under
   one request identifier (DCMP2-005). Identical context replay is permitted.
   This restriction does not constrain response digests: ResponseAnswers
   separately detects a signed response to substituted request content. */
restriction OneRequestContext:
  "All E rid h1 h2 #i #j.
     ContextRegistered(E, rid, h1) @ #i & ContextRegistered(E, rid, h2) @ #j
     ==> h1 = h2"

/* ------------------------------------------------------------------ */
/* Keys                                                                */

/* ECL1N-0157: a key is generated for one role and signs only for it. */
rule Register:
  [ Fr(~sk) ]
--[ Registered($X, $R, pk(~sk)) ]->
  [ !Ltk($X, $R, ~sk), !Pk($X, $R, pk(~sk)), Out(pk(~sk)) ]

#ifdef shared_role_key
/* Flaw: one key is registered for both the request and the response role,
   such as a key the governed runtime holds to sign its own requests. */
rule Register_shared:
  [ Fr(~sk) ]
--[ Registered($X, 'request', pk(~sk)), Registered($X, 'response', pk(~sk)) ]->
  [ !Ltk($X, 'request', ~sk), !Ltk($X, 'response', ~sk),
    !Pk($X, 'request', pk(~sk)), !Pk($X, 'response', pk(~sk)), Out(pk(~sk)) ]
#endif

rule Reveal:
  [ !Ltk($X, $R, sk) ]
--[ Reveal($X, $R) ]->
  [ Out(sk) ]

/* ------------------------------------------------------------------ */
/* Enforcement point: request                                          */

rule EP_Request:
  let req = <'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>
  in
  [ Fr(~rid), !Ltk($E, 'request', skE), In(<t, p>) ]
--[ EP_Sent($E, ~rid, h(req), t, p),
    ContextRegistered($E, ~rid, h(req)), EP_Context($E, $E, ~rid, h(req)) ]->
  [ EP_Wait($E, ~rid, req, t, p), !RequestContext($E, ~rid, req, $E),
    Out(<req, sign(pae('dcmp', req), skE)>) ]

/* An agent may sign its own request for an EP (ECL1N-0156). Adoption verifies
   that complete request under the issuer's request-role key. The requested
   audience remains data here; release still checks the signed authorization
   audience and the presented action. An adopted context cannot execute alone. */
rule EP_AdoptRequest:
  let req = <'decision_request', rid, issuer, aud, <t, p>, 'single_use'>
  in
  [ In(<req, rsig>), !Pk(issuer, 'request', pkI) ]
--[ RequestContextSignature(verify(rsig, pae('dcmp', req), pkI)),
    ContextRegistered($E, rid, h(req)), EP_Context($E, issuer, rid, h(req)) ]->
  [ !RequestContext($E, rid, req, issuer) ]

/* ------------------------------------------------------------------ */
/* Decision point                                                      */

rule DP_Decide:
  let req = <'decision_request', rid, issuer, aud, <t, p>, 'single_use'>
      auth = <'authorization', ~aid, aud, h(<rid, t, p>), 'single_use', ~win>
      resp = <'decision_response', ~mid, rid, h(req), 'admit', auth, $D>
  in
  [ In(<req, rsig>), !Pk(issuer, 'request', pkI), !Ltk($D, 'response', skD),
    Fr(~aid), Fr(~win), Fr(~mid) ]
--[ RequestSignature(verify(rsig, pae('dcmp', req), pkI)),
    DP_Seen($D, rid),
    DP_Issue($D, issuer, aud, rid, h(req), ~aid, t, p, ~win) ]->
  [ !Window(~aid, ~win), Out(<resp, sign(pae('dcmp', resp), skD)>) ]

rule Clock_expires:
  [ !Window(a, w) ]
--[ Expired(a, w) ]->
  [ ]

/* ------------------------------------------------------------------ */
/* Enforcement point: response and execution                           */

/* The EP verifies the response under the decision point's response key and
   checks that it answers exactly its request. */
rule EP_Receive:
  let req = <'decision_request', rid, E, E, <t, p>, 'single_use'>
      auth = <'authorization', aid, aud, scope, use, win>
      resp = <'decision_response', mid, rid2, dreq, 'admit', auth, D>
  in
  [ EP_Wait(E, rid, req, t, p), In(<resp, ssig>), !Pk(D, 'response', pkD) ]
--[ ResponseSignature(verify(ssig, pae('dcmp', resp), pkD)),
    ResponseAnswers(rid2, rid, dreq, h(req)),
    EP_Accept(E, D, rid, h(req), aid) ]->
  [ EP_Accepted(E, D, rid, h(req), t, p, aid, aud, scope, use, win) ]

rule EP_Execute:
  [ EP_Accepted(E, D, rid, hreq, t, p, aid, aud, scope, use, win) ]
--[ AudienceCheck(aud, E),
    ScopeCheck(scope, h(<rid, t, p>)),
    UseCheck(use),
    InWindow(aid, win),
    Consume(E, aid),
    Execute(E, t, p, aid, rid, win, D),
    ExecutedRequest(E, D, rid, hreq, aid) ]->
  [ ]

/* The governed AI system presents a signed response together with an action
   of its choice at an enforcement point of its choice. */
rule EP_Present:
  let req = <'decision_request', rid, issuer, requestedAud, <requestedT, requestedP>, 'single_use'>
      auth = <'authorization', aid, aud, scope, use, win>
      resp = <'decision_response', mid, rid2, dreq, 'admit', auth, D>
  in
  [ !RequestContext($E, rid, req, issuer),
    In(<t, p, resp, ssig>), !Pk(D, 'response', pkD) ]
--[ ResponseSignature(verify(ssig, pae('dcmp', resp), pkD)),
    PresentationAnswers(rid2, rid, dreq, h(req)),
    EP_Accept($E, D, rid, h(req), aid),
    AudienceCheck(aud, $E),
    ScopeCheck(scope, h(<rid, t, p>)),
    UseCheck(use),
    InWindow(aid, win),
    Consume($E, aid),
    Execute($E, t, p, aid, rid, win, D),
    ExecutedRequest($E, D, rid, h(req), aid) ]->
  [ ]

/* ------------------------------------------------------------------ */
/* Lemmas                                                              */

/* Existence of a request and matching execution without key compromise.
   Execute may come from EP_Execute or EP_Present; EP_Accept is not required
   by this lemma, so it does not establish nonvacuity of every antecedent. */
lemma executable:
  exists-trace
  "Ex E D t p a rid w #i #j.
     EP_Sent(E, rid, h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), t, p) @ #j
   & Execute(E, t, p, a, rid, w, D) @ #i
   & not (Ex X R #r. Reveal(X, R) @ #r)"

/* Request signing: a decision point issues authority only for a request that
   its named issuer signed, unless that issuer's request key was revealed. */
lemma request_origin:
  "All D I aud rid hreq a t p w #i.
     DP_Issue(D, I, aud, rid, hreq, a, t, p, w) @ #i
     ==> (Ex #k. EP_Sent(I, rid, hreq, t, p) @ #k & #k < #i)
       | (Ex #r. Reveal(I, 'request') @ #r & #r < #i)"

/* Response authenticity: a response an EP accepts was issued by the decision
   point it names, unless that decision point's response key was revealed. */
lemma response_authenticity:
  "All E D rid hreq a #i.
     EP_Accept(E, D, rid, hreq, a) @ #i
     ==> (Ex I aud rid2 hreq2 t p w #j. DP_Issue(D, I, aud, rid2, hreq2, a, t, p, w) @ #j & #j < #i)
       | (Ex #r. Reveal(D, 'response') @ #r & #r < #i)"

/* Request-response binding: the response answers exactly the authenticated
   request context, including agent-signed contexts, by identifier and digest,
   with the EP as audience, unless the named
   DP response key was revealed before acceptance. */
lemma request_response_binding:
  "All E D rid hreq a #i.
     EP_Accept(E, D, rid, hreq, a) @ #i
     ==> (Ex I t p w #j. DP_Issue(D, I, E, rid, hreq, a, t, p, w) @ #j & #j < #i)
       | (Ex #r. Reveal(D, 'response') @ #r & #r < #i)"

/* Every execution matches an authorization issued earlier by its named DP
   for that audience, request identifier, target, parameters and symbolic
   window, unless the DP response key was revealed before execution. Expiry
   ordering is the separate EnforcementClock restriction. */
lemma authorization_scope_and_audience:
  "All E t p a rid w D #i.
     Execute(E, t, p, a, rid, w, D) @ #i
     ==> (Ex I hreq #j. DP_Issue(D, I, E, rid, hreq, a, t, p, w) @ #j & #j < #i)
       | (Ex #r. Reveal(D, 'response') @ #r & #r < #i)"

/* Two executions of an authorization naming the same DP are one event,
   unless that DP response key is revealed anywhere in the trace. This is
   an at-most-once property; it does not require an execution. */
lemma single_use:
  "All E1 E2 t1 t2 p1 p2 a rid1 rid2 w1 w2 D #i #j.
     Execute(E1, t1, p1, a, rid1, w1, D) @ #i & Execute(E2, t2, p2, a, rid2, w2, D) @ #j
     ==> #i = #j | (Ex #r. Reveal(D, 'response') @ #r)"

/* At most one effect per request identifier and named DP, unless that DP
   response key is revealed anywhere in the trace. Different DPs are outside
   this uniqueness conclusion. */
lemma one_effect_per_request:
  "All E1 E2 t1 t2 p1 p2 a1 a2 rid w1 w2 D #i #j.
     Execute(E1, t1, p1, a1, rid, w1, D) @ #i & Execute(E2, t2, p2, a2, rid, w2, D) @ #j
     ==> #i = #j | (Ex #r. Reveal(D, 'response') @ #r)"


/* Both execution paths retain the digest of the authenticated request
   context. A scope digest alone does not bind its issuer or other context. */
lemma execution_request_binding:
  "All E D rid hreq a #i.
     ExecutedRequest(E, D, rid, hreq, a) @ #i
     ==> (Ex I t p w #j. DP_Issue(D, I, E, rid, hreq, a, t, p, w) @ #j & #j < #i)
       | (Ex #r. Reveal(D, 'response') @ #r & #r < #i)"

/* An actor-signed request can be adopted and executed at a distinct EP.
   Only that actor's request key is revealed; no response-key compromise. */
lemma agent_signed_executable:
  exists-trace
  "Ex I E D rid hreq t p a w #c #i #r.
      not (I = E)
    & Reveal(I, 'request') @ #r
    & EP_Context(E, I, rid, hreq) @ #c
    & Execute(E, t, p, a, rid, w, D) @ #i
    & #c < #i
    & (All X R #k. Reveal(X, R) @ #k ==> X = I & R = 'request')"

end
