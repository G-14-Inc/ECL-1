lemma executable:
  exists-trace
  "∃ E D t p a rid w #i #j.
    ((EP_Sent( E, rid,
               h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), t, p
      ) @ #j) ∧
     (Execute( E, t, p, a, rid, w, D ) @ #i)) ∧
    (¬(∃ X R #r. Reveal( X, R ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ E D t p a rid w #i #j.
  (EP_Sent( E, rid,
            h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), t, p
   ) @ #j) ∧
  (Execute( E, t, p, a, rid, w, D ) @ #i)
 ∧
  ∀ X R #r. (Reveal( X, R ) @ #r) ⇒ ⊥"
*/
by sorry

lemma request_origin:
  all-traces
  "∀ D I aud rid hreq a t p w #i.
    (DP_Issue( D, I, aud, rid, hreq, a, t, p, w ) @ #i) ⇒
    ((∃ #k. (EP_Sent( I, rid, hreq, t, p ) @ #k) ∧ (#k < #i)) ∨
     (∃ #r. (Reveal( I, 'request' ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ D I aud rid hreq a t p w #i.
  (DP_Issue( D, I, aud, rid, hreq, a, t, p, w ) @ #i)
 ∧
  (∀ #k. (EP_Sent( I, rid, hreq, t, p ) @ #k) ⇒ ¬(#k < #i)) ∧
  (∀ #r. (Reveal( I, 'request' ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

lemma response_authenticity:
  all-traces
  "∀ E D rid hreq a #i.
    (EP_Accept( E, D, rid, hreq, a ) @ #i) ⇒
    ((∃ I aud rid2 hreq2 t p w #j.
       (DP_Issue( D, I, aud, rid2, hreq2, a, t, p, w ) @ #j) ∧ (#j < #i)) ∨
     (∃ #r. (Reveal( D, 'response' ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ E D rid hreq a #i.
  (EP_Accept( E, D, rid, hreq, a ) @ #i)
 ∧
  (∀ I aud rid2 hreq2 t p w #j.
    (DP_Issue( D, I, aud, rid2, hreq2, a, t, p, w ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #r. (Reveal( D, 'response' ) @ #r) ⇒ ¬(#r < #i))"
*/
by sorry

lemma request_response_binding:
  all-traces
  "∀ E D rid hreq a #i.
    (EP_Accept( E, D, rid, hreq, a ) @ #i) ⇒
    ((∃ I t p w #j.
       (DP_Issue( D, I, E, rid, hreq, a, t, p, w ) @ #j) ∧ (#j < #i)) ∨
     (∃ #r. (Reveal( D, 'response' ) @ #r) ∧ (#r < #i)))"
/*
guarded formula characterizing all counter-examples:
