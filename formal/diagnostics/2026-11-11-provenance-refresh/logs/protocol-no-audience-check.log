theory DCMP2_Binding

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pae/2, pair/2, pk/1, sign/2, snd/1, true/0,
           verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

restriction RequestSignatureVerified:
  "∀ x #i. (RequestSignature( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (RequestSignature( x ) @ #i) ⇒ (x = true)"
  */

restriction UniqueRequestIdentifier:
  "∀ d rid #i #j.
    ((DP_Seen( d, rid ) @ #i) ∧ (DP_Seen( d, rid ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ d rid #i #j.
    ((DP_Seen( d, rid ) @ #i) ∧ (DP_Seen( d, rid ) @ #j)) ⇒ (#i = #j)"
  */

restriction ResponseSignatureVerified:
  "∀ x #i. (ResponseSignature( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (ResponseSignature( x ) @ #i) ⇒ (x = true)"
  */

restriction ResponseAnswersTheRequest:
  "∀ r1 r2 d1 d2 #i.
    (ResponseAnswers( r1, r2, d1, d2 ) @ #i) ⇒ ((r1 = r2) ∧ (d1 = d2))"
  // safety formula

  /*
  expanded formula:
  "∀ r1 r2 d1 d2 #i.
    (ResponseAnswers( r1, r2, d1, d2 ) @ #i) ⇒ ((r1 = r2) ∧ (d1 = d2))"
  */

restriction PresentationAnswersTheRequest:
  "∀ r1 r2 d1 d2 #i.
    (PresentationAnswers( r1, r2, d1, d2 ) @ #i) ⇒ ((r1 = r2) ∧ (d1 = d2))"
  // safety formula

  /*
  expanded formula:
  "∀ r1 r2 d1 d2 #i.
    (PresentationAnswers( r1, r2, d1, d2 ) @ #i) ⇒ ((r1 = r2) ∧ (d1 = d2))"
  */

restriction ScopeCoversTheAction:
  "∀ s1 s2 #i. (ScopeCheck( s1, s2 ) @ #i) ⇒ (s1 = s2)"
  // safety formula

  /*
  expanded formula:
  "∀ s1 s2 #i. (ScopeCheck( s1, s2 ) @ #i) ⇒ (s1 = s2)"
  */

restriction SingleUse:
  "∀ e a #i #j.
    ((Consume( e, a ) @ #i) ∧ (Consume( e, a ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ e a #i #j.
    ((Consume( e, a ) @ #i) ∧ (Consume( e, a ) @ #j)) ⇒ (#i = #j)"
  */

restriction UsePolicy:
  "∀ u #i. (UseCheck( u ) @ #i) ⇒ (u = 'single_use')"
  // safety formula

  /*
  expanded formula:
  "∀ u #i. (UseCheck( u ) @ #i) ⇒ (u = 'single_use')"
  */

restriction EnforcementClock:
  "∀ a w #i #j.
    ((InWindow( a, w ) @ #i) ∧ (Expired( a, w ) @ #j)) ⇒ (#i < #j)"
  // safety formula

  /*
  expanded formula:
  "∀ a w #i #j.
    ((InWindow( a, w ) @ #i) ∧ (Expired( a, w ) @ #j)) ⇒ (#i < #j)"
  */

restriction OneRegistration:
  "∀ x r k1 k2 #i #j.
    ((Registered( x, r, k1 ) @ #i) ∧ (Registered( x, r, k2 ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x r k1 k2 #i #j.
    ((Registered( x, r, k1 ) @ #i) ∧ (Registered( x, r, k2 ) @ #j)) ⇒
    (#i = #j)"
  */

restriction RequestContextSignatureVerified:
  "∀ x #i. (RequestContextSignature( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (RequestContextSignature( x ) @ #i) ⇒ (x = true)"
  */

restriction PresentationPreservesTheRequest:
  "∀ a1 a2 t1 t2 p1 p2 #i.
    (PresentationContext( a1, a2, t1, t2, p1, p2 ) @ #i) ⇒
    (((a1 = a2) ∧ (t1 = t2)) ∧ (p1 = p2))"
  // safety formula

  /*
  expanded formula:
  "∀ a1 a2 t1 t2 p1 p2 #i.
    (PresentationContext( a1, a2, t1, t2, p1, p2 ) @ #i) ⇒
    (((a1 = a2) ∧ (t1 = t2)) ∧ (p1 = p2))"
  */

restriction OneRequestContext:
  "∀ E rid h1 h2 #i #j.
    ((ContextRegistered( E, rid, h1 ) @ #i) ∧
     (ContextRegistered( E, rid, h2 ) @ #j)) ⇒
    (h1 = h2)"
  // safety formula

  /*
  expanded formula:
  "∀ E rid h1 h2 #i #j.
    ((ContextRegistered( E, rid, h1 ) @ #i) ∧
     (ContextRegistered( E, rid, h2 ) @ #j)) ⇒
    (h1 = h2)"
  */

rule (modulo E) Register:
   [ Fr( ~sk ) ]
  --[ Registered( $X, $R, pk(~sk) ) ]->
   [ !Ltk( $X, $R, ~sk ), !Pk( $X, $R, pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal:
   [ !Ltk( $X, $R, sk ) ] --[ Reveal( $X, $R ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) EP_Request:
   [ Fr( ~rid ), !Ltk( $E, 'request', skE ), In( <t, p> ) ]
  --[
  EP_Sent( $E, ~rid,
           h(<'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>), t, p
  ),
  ContextRegistered( $E, ~rid,
                     h(<'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>)
  ),
  EP_Context( $E, $E, ~rid,
              h(<'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>)
  )
  ]->
   [
   EP_Wait( $E, ~rid,
            <'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>, t, p
   ),
   !RequestContext( $E, ~rid,
                    <'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>, $E
   ),
   Out( <<'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>, 
         sign(pae('dcmp',
                  <'decision_request', ~rid, $E, $E, <t, p>, 'single_use'>),
              skE)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) EP_AdoptRequest:
   [
   In( <<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>, rsig>
   ),
   !Pk( issuer, 'request', pkI )
   ]
  --[
  RequestContextSignature( verify(rsig,
                                  pae('dcmp',
                                      <'decision_request', rid, issuer, aud, <t, p>, 'single_use'>),
                                  pkI)
  ),
  ContextRegistered( $E, rid,
                     h(<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>)
  ),
  EP_Context( $E, issuer, rid,
              h(<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>)
  )
  ]->
   [
   !RequestContext( $E, rid,
                    <'decision_request', rid, issuer, aud, <t, p>, 'single_use'>, issuer
   )
   ]

