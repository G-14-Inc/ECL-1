     )
     ]
    variants (modulo AC)
    1. aud   = aud.20
       issuer
             = issuer.21
       p     = p.22
       pkI   = pkI.23
       rid   = rid.24
       rsig  = rsig.25
       t     = t.26
       z     = verify(rsig.25,
                      pae('dcmp',
                          <'decision_request', rid.24, issuer.21, aud.20, <t.26, p.22>, 
                           'single_use'>),
                      pkI.23)
    
    2. aud   = aud.39
       issuer
             = issuer.40
       p     = p.41
       pkI   = pk(x.75)
       rid   = rid.43
       rsig  = sign(pae('dcmp',
                        <'decision_request', rid.43, issuer.40, aud.39, <t.45, p.41>, 
                         'single_use'>),
                    x.75)
       t     = t.45
       z     = true
  */

rule (modulo E) DP_Decide:
   [
   In( <<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>, rsig>
   ),
   !Pk( issuer, 'request', pkI ), !Ltk( $D, 'response', skD ), Fr( ~aid ),
   Fr( ~win ), Fr( ~mid )
   ]
  --[
  RequestSignature( verify(rsig,
                           pae('dcmp',
                               <'decision_request', rid, issuer, aud, <t, p>, 'single_use'>),
                           pkI)
  ),
  DP_Seen( $D, rid ),
  DP_Issue( $D, issuer, aud, rid,
            h(<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>), ~aid, t,
            p, ~win
  )
  ]->
   [
   !Window( ~aid, ~win ),
   Out( <
         <'decision_response', ~mid, rid, 
          h(<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>), 
          'admit', 
          <'authorization', ~aid, aud, h(<rid, t, p>), 'single_use', ~win>, $D>, 
         sign(pae('dcmp',
                  <'decision_response', ~mid, rid, 
                   h(<'decision_request', rid, issuer, aud, <t, p>, 'single_use'>), 
                   'admit', 
                   <'authorization', ~aid, aud, h(<rid, t, p>), 'single_use', ~win>, $D>),
              skD)
        >
   )
   ]

  /*
