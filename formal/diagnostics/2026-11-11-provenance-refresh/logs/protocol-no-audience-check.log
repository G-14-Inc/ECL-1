                      pkI.33)
    
    2. aud   = aud.145
       issuer
             = issuer.146
       p     = p.147
       pkI   = pk(x.284)
       rid   = rid.149
       rsig  = sign(pae('dcmp',
                        <'decision_request', rid.149, issuer.146, aud.145, <t.152, p.147>, 
                         'single_use'>),
                    x.284)
       t     = t.152
       z     = true
  */

rule (modulo E) Clock_expires:
   [ !Window( a, w ) ] --[ Expired( a, w ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) EP_Receive:
   [
   EP_Wait( E, rid, <'decision_request', rid, E, E, <t, p>, 'single_use'>,
            t, p
   ),
   In( <
        <'decision_response', mid, rid2, dreq, 'admit', 
         <'authorization', aid, aud, scope, use, win>, D>, 
        ssig>
   ),
   !Pk( D, 'response', pkD )
   ]
  --[
  ResponseSignature( verify(ssig,
                            pae('dcmp',
                                <'decision_response', mid, rid2, dreq, 'admit', 
                                 <'authorization', aid, aud, scope, use, win>, D>),
                            pkD)
  ),
  ResponseAnswers( rid2, rid, dreq,
                   h(<'decision_request', rid, E, E, <t, p>, 'single_use'>)
  ),
  EP_Accept( E, D, rid,
             h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), aid
  )
  ]->
   [
   EP_Accepted( E, D, rid,
                h(<'decision_request', rid, E, E, <t, p>, 'single_use'>), t, p, aid, aud,
                scope, use, win
   )
   ]

