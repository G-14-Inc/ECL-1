rule (modulo E) EP_Execute:
   [ EP_Accepted( E, D, rid, hreq, t, p, aid, aud, scope, use, win ) ]
  --[
  AudienceCheck( aud, E ), ScopeCheck( scope, h(<rid, t, p>) ),
  UseCheck( use ), InWindow( aid, win ), Consume( E, aid ),
  Execute( E, t, p, aid, rid, win, D ),
  ExecutedRequest( E, D, rid, hreq, aid ),
  ExecutedAuthorization( E, D, rid, aid, aud, scope, use )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) EP_Present:
   [
   !RequestContext( $E, rid,
                    <'decision_request', rid, issuer, requestedAud, 
                     <requestedT, requestedP>, 'single_use'>,
                    issuer
   ),
   In( <t, p, 
        <'decision_response', mid, rid2, dreq, 'admit', 
         <'authorization', aid, aud, scope, use, win>, D>, 
        ssig>
   ),
   !Pk( D, 'response', pkD )
   ]
  --[
  ResponseSignature( verify(ssig,
                            pae('dcmp',
                                <'decision_response', mid, rid2, dreq, 'admit', 
                                 <'authorization', aid, aud, scope, use, win>, D>),
                            pkD)
  ),
  PresentationAnswers( rid2, rid, dreq,
                       h(<'decision_request', rid, issuer, requestedAud, 
                          <requestedT, requestedP>, 'single_use'>)
  ),
  PresentationContext( aud, requestedAud, t, requestedT, p, requestedP ),
  EP_Accept( $E, D, rid,
             h(<'decision_request', rid, issuer, requestedAud, 
                <requestedT, requestedP>, 'single_use'>),
             aid
  ),
  AudienceCheck( aud, $E ), ScopeCheck( scope, h(<rid, t, p>) ),
  UseCheck( use ), InWindow( aid, win ), Consume( $E, aid ),
  Execute( $E, t, p, aid, rid, win, D ),
  ExecutedRequest( $E, D, rid,
                   h(<'decision_request', rid, issuer, requestedAud, 
                      <requestedT, requestedP>, 'single_use'>),
                   aid
  ),
  ExecutedAuthorization( $E, D, rid, aid, aud, scope, use )
  ]->
   [ ]

