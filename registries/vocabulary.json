    {
      "id": "ecl.purpose.evidence-event.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "additive",
      "description": "A key trusted to sign EBMP-2 evidence events for the principal it is bound to.",
      "attributes": {"category": "key_purpose"}
    },
    {
      "id": "ecl.purpose.observation.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "additive",
      "description": "A key trusted to sign EBMP-2 observation events, which attest the observed state of a resource, for the principal it is bound to.",
      "attributes": {"category": "key_purpose"}
    },
    {
      "id": "ecl.purpose.approval.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.6",
      "compatibility": "additive",
      "description": "A key trusted to sign the approval records of the approval service it is bound to, EBMP-2 human intervention events that approve a request, which a verifier admits as the proof of an approval obligation only when every key that signed them holds this purpose (EBMP2-070, MG1-013); it qualifies a key that also holds the evidence-event purpose and by itself lets a key sign no payload.",
      "attributes": {"category": "key_purpose"}
    },
    {
      "id": "ecl.principal.human.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "additive",
      "description": "A natural person acting as a principal, for example an approver in a human intervention event (EBMP2-016).",
      "attributes": {"category": "principal_type"}
    },
    {
      "id": "ecl.principal.organization.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "additive",
      "description": "An approved organizational principal acting through its own authority, for example a delegated approval unit (EBMP2-016).",
      "attributes": {"category": "principal_type"}
    },
    {
      "id": "ecl.verification-profile.reference.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "behavioral",
      "description": "The reference evidence verification profile: a response clock-skew allowance of zero seconds (DCMP2-047) and a state-outcome table whose dependency failures resolve to a fail-closed deny (EBMP2-051).",
      "attributes": {"category": "verification_profile"}
    },
    {
      "id": "ecl.purpose.trusted-time.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "additive",
      "description": "A key trusted to sign time attestations (INTEGRITY-ENVELOPE-1 section 9) for the time authority it is bound to.",
      "attributes": {"category": "key_purpose"}
    },
    {
      "id": "ecl.claim.trusted-time.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "behavioral",
      "description": "A countersignature claim: the time authority attests that the covered payload digest and the envelope signatures it names existed no later than the attested time (IE1-032 to IE1-034).",
      "attributes": {"category": "countersignature_claim"}
    },
    {
      "id": "ecl.verification-profile.reference-trusted-time.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "behavioral",
      "description": "The reference evidence verification profile, which also requires a valid trusted-time countersignature on every envelope (IE1-035).",
      "attributes": {"category": "verification_profile"}
    }
