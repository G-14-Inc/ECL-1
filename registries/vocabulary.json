    },
    {
      "id": "ecl.purpose.decision-response.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.4",
      "compatibility": "additive",
      "description": "A key trusted to sign DCMP-2 decision responses for the principal it is bound to.",
      "attributes": {"category": "key_purpose"}
    },
    {
      "id": "ecl.purpose.control.v1",
      "status": "active",
      "owner_class": "ecl-registry",
      "introduced_in": "1.0-rc.5",
      "compatibility": "additive",
      "description": "A key trusted to sign DCMP-2 control messages for the control-plane principal it is bound to (TP1-009, IE1-039).",
      "attributes": {"category": "key_purpose"}
