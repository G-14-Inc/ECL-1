{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/evaluation-implementation-map/2",
  "title": "ECL Evaluation Implementation Map v2",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_version",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ecl_evaluation_implementation_map_v2"
    },
    "candidate_version": {
      "const": "1.0"
    },
    "groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_ids",
          "method",
          "evaluation_class",
          "evaluation_refs",
          "evidence_obligations",
          "procedure",
          "pass_criteria",
          "fail_criteria"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,11}-[0-9]{3,5}$"
            }
          },
          "method": {
            "enum": [
              "automated",
              "human_assessed",
              "hybrid"
            ]
          },
          "evaluation_refs": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^tests\\.[A-Za-z0-9_]+\\.[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)?$"
            }
          },
          "evidence_obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "procedure": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pass_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fail_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluation_class": {
            "description": "reference-tested: the refs run the reference implementation and fail when the behavior regresses. assessor-procedure: an assessor examines the claimant's evidence by the procedure; the refs only check that declarations are complete and consistent. self-declaration: the claimant's own declaration establishes the requirement; an assessor checks that it is present, complete and consistent.",
            "enum": [
              "reference-tested",
              "assessor-procedure",
              "self-declaration"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evaluation_class": {
                  "const": "reference-tested"
                }
              }
            },
            "then": {
              "properties": {
                "evaluation_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "traceability_refs": {
      "description": "Tests of the maintainer's implementation that trace a requirement without evaluating it, by requirement identifier. They are platform references: the compiler lists them in registries/requirements-internal-refs.json, never in a public file.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9]{1,11}-[0-9]{3,5}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^tests\\.[A-Za-z0-9_]+\\.[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)?$"
        }
      }
    }
  }
}
