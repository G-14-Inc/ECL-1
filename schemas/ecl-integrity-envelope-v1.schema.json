{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/integrity-envelope/1",
  "title": "ECL Integrity Envelope v1",
  "type": "object",
  "required": [
    "envelope_version",
    "payload_type",
    "payload",
    "payload_digest",
    "signatures"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope_version": {
      "const": "ECL-IE-1"
    },
    "payload_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[ -~]+)?$"
    },
    "payload": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/base64"
    },
    "payload_digest": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "suite_id",
          "signature"
        ],
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
          },
          "suite_id": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
          },
          "signature": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/base64"
          }
        }
      }
    },
    "verification_material": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
      }
    },
    "time_evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
      }
    },
    "extensions": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/extensionSet"
    },
    "envelope_artifact_version": {
      "description": "Increases each time verification material or a countersignature is added to the envelope (IE1-026); absent means 1.",
      "type": "integer",
      "minimum": 2,
      "maximum": 64
    },
    "countersignatures": {
      "description": "Countersignatures over the envelope's payload type, payload digest and the signatures each names (IE1-025, IE1-032, IE1-033).",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/countersignature"
      }
    }
  },
  "dependentRequired": {
    "countersignatures": [
      "envelope_artifact_version"
    ]
  },
  "$defs": {
    "countersignature": {
      "type": "object",
      "required": [
        "counter_id",
        "claim",
        "attestation"
      ],
      "additionalProperties": false,
      "properties": {
        "counter_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "claim": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
        },
        "attestation": {
          "$ref": "#/$defs/signedPayload"
        }
      }
    },
    "signedPayload": {
      "description": "An ECL-IE-1 envelope without countersignatures or added material: the form of a countersignature's attestation.",
      "type": "object",
      "required": [
        "envelope_version",
        "payload_type",
        "payload",
        "payload_digest",
        "signatures"
      ],
      "additionalProperties": false,
      "properties": {
        "envelope_version": {
          "const": "ECL-IE-1"
        },
        "payload_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[ -~]+)?$"
        },
        "payload": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/base64"
        },
        "payload_digest": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "key_id",
              "suite_id",
              "signature"
            ],
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
              },
              "suite_id": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
              },
              "signature": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/base64"
              }
            }
          }
        }
      }
    }
  }
}
