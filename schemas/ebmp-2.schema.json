{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/ebmp/2",
  "title": "ECL Evidence Bundle and Manifest Protocol 2",
  "oneOf": [
    {
      "$ref": "#/$defs/eventRecord"
    },
    {
      "$ref": "#/$defs/bundleManifest"
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "protocol",
        "schema_version",
        "object_type",
        "object_id",
        "workflow",
        "producer",
        "observed_at",
        "extensions",
        "integrity_policy"
      ],
      "properties": {
        "protocol": {
          "const": "EBMP-2"
        },
        "schema_version": {
          "const": "2.0"
        },
        "object_type": {
          "type": "string"
        },
        "object_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "workflow": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/workflowContext"
        },
        "producer": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/principal"
        },
        "observed_at": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
        },
        "monotonic_observation": {
          "type": "object",
          "required": [
            "clock_id",
            "ticks",
            "unit"
          ],
          "additionalProperties": false,
          "properties": {
            "clock_id": {
              "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
            },
            "ticks": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 64
            },
            "unit": {
              "enum": [
                "nanosecond",
                "microsecond",
                "millisecond"
              ]
            }
          }
        },
        "extensions": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/extensionSet"
        },
        "integrity_policy": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/integrityPolicy"
        }
      }
    },
    "eventRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "event"
          ],
          "properties": {
            "object_type": {
              "const": "event_record"
            },
            "event_type": {
              "type": "string",
              "enum": [
                "request_received",
                "decision_recorded",
                "authority_issued",
                "authority_consumed",
                "release_prepared",
                "execution_released",
                "execution_observed",
                "execution_terminal",
                "human_intervention",
                "verification",
                "safe_state_transition",
                "fleet_transition",
                "lifecycle_transition"
              ]
            },
            "event": {
              "oneOf": [
                {
                  "$ref": "#/$defs/requestEvent"
                },
                {
                  "$ref": "#/$defs/decisionEvent"
                },
                {
                  "$ref": "#/$defs/authorityEvent"
                },
                {
                  "$ref": "#/$defs/executionEvent"
                },
                {
                  "$ref": "#/$defs/interventionEvent"
                },
                {
                  "$ref": "#/$defs/verificationEvent"
                },
                {
                  "$ref": "#/$defs/stateEvent"
                },
                {
                  "$ref": "#/$defs/lifecycleEvent"
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "execution_released"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "properties": {
              "event": {
                "required": [
                  "release_guard_ms"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "event": {
                "not": {
                  "required": [
                    "release_guard_ms"
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "requestEvent": {
      "type": "object",
      "required": [
        "kind",
        "request"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "request"
        },
        "request": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        }
      }
    },
    "decisionEvent": {
      "type": "object",
      "required": [
        "kind",
        "decision",
        "outcome",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "decision"
        },
        "decision": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "outcome": {
          "enum": [
            "admit",
            "deny",
            "hold",
            "challenge"
          ]
        },
        "policy": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/policyReference"
        },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/reason"
          }
        }
      }
    },
    "authorityEvent": {
      "type": "object",
      "required": [
        "kind",
        "authorization_id",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "authority"
        },
        "authorization_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "state": {
          "enum": [
            "issued",
            "active",
            "consumed",
            "revoked",
            "expired",
            "superseded"
          ]
        },
        "authority": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "use_count": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/nonNegativeSafeInteger"
        }
      }
    },
    "executionEvent": {
      "type": "object",
      "required": [
        "kind",
        "action_id",
        "attempt_id",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "execution"
        },
        "action_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "attempt_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "state": {
          "enum": [
            "not_started",
            "prepared",
            "released",
            "running",
            "succeeded",
            "failed",
            "partially_succeeded",
            "cancelled",
            "timed_out",
            "rolled_back",
            "compensated",
            "unknown",
            "denied",
            "held",
            "challenged",
            "expired_before_release"
          ]
        },
        "decision": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "authority": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "target": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "operation": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/asciiToken"
        },
        "parameters_digest": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
        },
        "result": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "side_effects": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
          }
        },
        "residual_state": {
          "type": "string",
          "maxLength": 4096
        },
        "release_guard_ms": {
          "description": "EBMP2-071: on an execution_released event, the enforcement point's declared bound, in milliseconds, on the delay from the final observation that observed_at records to the release (the release guard its profile declares). A verifier adds it to observed_at when it tests the release against the authorization's valid_until (EBMP2-050). Required on execution_released and not carried by any other execution event.",
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "interventionEvent": {
      "type": "object",
      "required": [
        "kind",
        "intervention_id",
        "actor",
        "operation",
        "target_id",
        "authority",
        "issued_at",
        "expires_at",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "intervention"
        },
        "intervention_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "actor": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/principal"
        },
        "operation": {
          "enum": [
            "approve",
            "reject",
            "cancel",
            "quarantine",
            "halt",
            "release",
            "override"
          ]
        },
        "target_id": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "authority": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "issued_at": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
        },
        "expires_at": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
        },
        "reason": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/reason"
        }
      }
    },
    "verificationEvent": {
      "type": "object",
      "required": [
        "kind",
        "verifier",
        "subject",
        "decision",
        "rules",
        "findings",
        "registry_snapshot",
        "evidence_boundary"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "verification"
        },
        "verifier": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/principal"
        },
        "subject": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "decision": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/reason"
          }
        },
        "registry_snapshot": {
          "description": "EBMP2-019: the registry versions the verifier applied, as an immutable digest-bound reference.",
          "allOf": [
            {
              "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
            },
            {
              "required": [
                "digest"
              ]
            }
          ]
        },
        "evidence_boundary": {
          "description": "EBMP2-019: what the verifier observed and could not observe.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "stateEvent": {
      "type": "object",
      "required": [
        "kind",
        "scope",
        "prior_state",
        "new_state",
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "state"
        },
        "scope": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
        },
        "prior_state": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
        },
        "new_state": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
        },
        "trigger": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/reason"
        },
        "frontiers": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/nonNegativeSafeInteger"
          }
        }
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "required": [
        "kind",
        "subject",
        "operation",
        "policy",
        "prior_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lifecycle"
        },
        "subject": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "operation": {
          "enum": [
            "seal",
            "verify",
            "verification_fail",
            "retain",
            "export",
            "redact",
            "supersede",
            "revoke",
            "legal_hold",
            "release_hold",
            "destroy"
          ]
        },
        "policy": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/policyReference"
        },
        "prior_digest": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
        },
        "derived_artifact": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "redaction_manifest": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        },
        "destruction_proof": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
        }
      }
    },
    "bundleManifest": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "bundle_profile",
            "records",
            "closure"
          ],
          "properties": {
            "object_type": {
              "const": "bundle_manifest"
            },
            "bundle_profile": {
              "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000000,
              "items": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
              }
            },
            "closure": {
              "type": "object",
              "required": [
                "status",
                "terminal_action_ids",
                "open_action_ids",
                "unresolved_predecessor_ids"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "complete",
                    "incomplete",
                    "indeterminate"
                  ]
                },
                "terminal_action_ids": {
                  "type": "array",
                  "maxItems": 1000000,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
                  }
                },
                "open_action_ids": {
                  "type": "array",
                  "maxItems": 1000000,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
                  }
                },
                "unresolved_predecessor_ids": {
                  "type": "array",
                  "maxItems": 1000000,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
                  }
                }
              }
            },
            "registry_snapshot": {
              "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
            },
            "trust_bundle": {
              "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
