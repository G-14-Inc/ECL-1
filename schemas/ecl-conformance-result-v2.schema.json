{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/conformance-result/2",
  "title": "ECL Conformance Result v2",
  "type": "object",
  "required": [
    "schema_version",
    "suite",
    "candidate_version",
    "decision",
    "vector_count",
    "passed_vector_count",
    "failed_vector_count",
    "results",
    "suites"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ecl_conformance_result_v2"
    },
    "suite": {
      "type": "string"
    },
    "candidate_version": {
      "const": "1.0"
    },
    "decision": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "vector_count": {
      "type": "integer",
      "minimum": 1
    },
    "passed_vector_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_vector_count": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "expected",
          "artifact_sha256",
          "observed_primary_id",
          "observed_secondary_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "expected": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_primary_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "observed_secondary_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "suite",
          "decision",
          "vector_count",
          "passed_vector_count",
          "failed_vector_count",
          "results"
        ],
        "additionalProperties": false,
        "properties": {
          "suite": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "vector_count": {
            "type": "integer",
            "minimum": 1
          },
          "passed_vector_count": {
            "type": "integer",
            "minimum": 0
          },
          "failed_vector_count": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "decision",
                "expected",
                "artifact_sha256",
                "observed_primary_id",
                "observed_secondary_ids"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "decision": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "expected": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "observed_primary_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "observed_secondary_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
