{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/offline-verification-package/1",
  "title": "ECL Offline Verification Package Manifest v1",
  "type": "object",
  "required": [
    "package_id",
    "package_version",
    "created_at",
    "expires_at",
    "verification_time_policy",
    "trust_policy",
    "revocation_snapshot",
    "registry_snapshots",
    "time_evidence",
    "artifacts",
    "deterministic_assembly"
  ],
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
    },
    "package_version": {
      "const": "1.0-rc.1"
    },
    "created_at": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
    },
    "expires_at": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
    },
    "verification_time_policy": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
    },
    "trust_policy": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
    },
    "revocation_snapshot": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
    },
    "registry_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
      }
    },
    "time_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "media_type",
          "role",
          "size_bytes",
          "digest"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "media_type": {
            "type": "string",
            "minLength": 3
          },
          "role": {
            "enum": [
              "payload",
              "envelope",
              "observation",
              "trust_policy",
              "verification_key",
              "trust_root",
              "revocation_snapshot",
              "registry_snapshot",
              "time_evidence",
              "transparency_proof",
              "conformance_result"
            ],
            "description": "What the artifact is. The envelope and observation artifacts are the envelopes and the observations of the evidence bundle the package carries, and each payload artifact is the canonical payload of one of them (IE1-021); every other role is material the producer used, which a verifier treats as evidence and never as a trust anchor (IE1-022)."
          },
          "size_bytes": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/nonNegativeSafeInteger"
          },
          "digest": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
          }
        }
      }
    },
    "deterministic_assembly": {
      "type": "object",
      "required": [
        "entry_order",
        "timestamp_policy",
        "permissions_policy",
        "path_encoding_policy",
        "storage_policy",
        "container_profile"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_order": {
          "const": "utf8-bytewise-path"
        },
        "timestamp_policy": {
          "const": "zip-epoch-1980-01-01T00:00:00Z"
        },
        "permissions_policy": {
          "const": "regular-files-0644-no-directory-entries"
        },
        "path_encoding_policy": {
          "const": "utf8-nfc-posix-relative"
        },
        "storage_policy": {
          "const": "zip-stored"
        },
        "container_profile": {
          "const": "ecl.zip.store.v1"
        }
      }
    }
  }
}
