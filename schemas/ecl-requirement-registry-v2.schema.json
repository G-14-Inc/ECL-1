{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/requirement-registry/2",
  "title": "ECL Requirement Registry v2",
  "type": "object",
  "required": [
    "schema_version",
    "standard_id",
    "candidate_version",
    "source_files",
    "requirements",
    "orphan_normative_statements",
    "duplicate_requirement_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ecl_requirement_registry_v2"
    },
    "standard_id": {
      "const": "ECL-1"
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "orphan_normative_statements": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/orphan"
      }
    },
    "duplicate_requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "requirement_id",
        "status",
        "source_path",
        "source_line",
        "source_heading",
        "text",
        "normative_forces",
        "introduced_in",
        "text_sha256",
        "testability",
        "evidence_obligations",
        "test_refs",
        "conformance_roles"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,11}-[0-9]{3,5}$"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "superseded"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_heading": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "normative_forces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MUST",
              "MUST_NOT",
              "SHOULD",
              "SHOULD_NOT",
              "MAY",
              "REQUIRED",
              "SHALL",
              "SHALL_NOT",
              "RECOMMENDED",
              "NOT_RECOMMENDED",
              "OPTIONAL"
            ]
          }
        },
        "introduced_in": {
          "type": "string"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "testability": {
          "enum": [
            "automated",
            "human_assessed",
            "hybrid",
            "unassigned"
          ]
        },
        "evidence_obligations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "test_refs": {
          "description": "Public references only: conformance:requirement:<id>, the requirement's own conformance evaluation, and conformance.vector:<id> for each vector that cites it.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^conformance(?::requirement:[A-Z][A-Z0-9]{1,11}-[0-9]{3,5}|\\.vector:[a-z0-9][a-z0-9-]*)$"
          }
        },
        "conformance_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "orphan": {
      "type": "object",
      "required": [
        "source_path",
        "source_line",
        "source_heading",
        "text",
        "normative_forces"
      ],
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_heading": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "normative_forces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
