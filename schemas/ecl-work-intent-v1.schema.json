{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/work-intent/1",
  "title": "ECL Distributed Work Intent v1",
  "type": "object",
  "required": [
    "protocol",
    "schema_version",
    "intent_id",
    "agent",
    "workflow",
    "issued_at",
    "expires_at",
    "exact_targets",
    "semantic_topics",
    "dependency_epochs",
    "declared_outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "ECL-WI-1"
    },
    "schema_version": {
      "const": "1.0-rc.1"
    },
    "intent_id": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
    },
    "agent": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/principal"
    },
    "workflow": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/workflowContext"
    },
    "parent_workflow": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/resourceReference"
    },
    "issued_at": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
    },
    "expires_at": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
    },
    "exact_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "identifier"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "file",
              "symbol",
              "contract",
              "migration",
              "schema",
              "test",
              "claim",
              "resource"
            ]
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "digest": {
            "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
          }
        }
      }
    },
    "semantic_topics": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "dependency_epochs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "declared_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "extensions": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/extensionSet"
    },
    "integrity_policy": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/integrityPolicy"
    }
  }
}
