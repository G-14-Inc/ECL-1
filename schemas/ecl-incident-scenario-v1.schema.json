    "propose": {
      "description": "The governed agent proposes an action with exact parameters. With repeat, it proposes it that many times, `{n}` in the target and in string parameters standing for 1 to repeat.",
      "type": "object",
      "required": [
        "kind",
        "actor",
        "operation",
        "target",
        "parameters",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "step": true,
        "at": true,
        "origin": true,
        "note": true,
        "requirements": true,
        "kind": {
          "const": "propose"
        },
        "actor": {
          "$ref": "#/$defs/uri"
        },
        "instance": {
          "$ref": "#/$defs/token"
        },
        "operation": {
          "$ref": "#/$defs/token"
        },
        "target": {
          "description": "The URI of the resource the action affects; in a repeated proposal `{n}` stands for its number.",
          "$ref": "#/$defs/uri"
        },
        "parameters": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "tool": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/token"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "repeat": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "spacing_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "expect": {
          "$ref": "#/$defs/proposalExpectation"
        }
      }
    },
    "decide": {
      "description": "A person approves or rejects held actions of an earlier propose step, all of them or the one at index.",
      "type": "object",
      "required": [
        "kind",
        "person",
        "decision",
        "target_step",
        "expect"
