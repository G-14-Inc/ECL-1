{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://externalcontrollayer.ai/ns/schema/time-attestation/1",
  "title": "ECL Time Attestation v1",
  "description": "The payload of a trusted-time countersignature: a time authority's signed statement that the covered payload digest and the covered envelope signatures existed no later than issued_at (INTEGRITY-ENVELOPE-1 section 9). Its media type is application/vnd.ecl.time-attestation+json.",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_id",
    "claim",
    "covered",
    "issuer",
    "issued_at",
    "integrity_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ecl_time_attestation_v1"
    },
    "attestation_id": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
    },
    "claim": {
      "const": "ecl.claim.trusted-time.v1"
    },
    "covered": {
      "type": "object",
      "required": [
        "media_type",
        "digest",
        "signatures"
      ],
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[ -~]+)?$"
        },
        "digest": {
          "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
        },
        "signatures": {
          "description": "The envelope signatures that the attestation covers, in the envelope's order: for each, its key_id, its suite (the entry's suite_id) and signature_digest, the ecl.digest.sha-256.v1 digest of the signature bytes that the entry's signature value encodes (INTEGRITY-ENVELOPE-1 IE1-033).",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "key_id",
              "suite",
              "signature_digest"
            ],
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/uri"
              },
              "suite": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/eclRegistryId"
              },
              "signature_digest": {
                "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "issuer": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/principal"
    },
    "issued_at": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/rfc3339Utc"
    },
    "integrity_policy": {
      "$ref": "https://externalcontrollayer.ai/ns/schema/common/1#/$defs/integrityPolicy"
    }
  }
}
