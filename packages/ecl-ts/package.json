{
  "name": "ecl-ts",
  "version": "1.0.0",
  "description": "ECL-1 strict JSON, canonicalization, integrity envelopes, trust policies and offline evidence-bundle verification for TypeScript and JavaScript.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ecl-verify-ts": "./dist/cli/ecl-verify.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"build/test/unit/*.test.js\"",
    "verifier:build": "node scripts/build-verifier.mjs",
    "verifier:check": "node scripts/build-verifier.mjs --check",
    "test:browser": "node --test --test-concurrency=1 --test-reporter=spec \"build/test/browser/*.test.js\""
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "6.0.3"
  }
}
